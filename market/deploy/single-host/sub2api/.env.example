# 复制为 sub2api/.env（权限 600）。随机值用 openssl rand -hex 24 生成。
# 宿主镜像与 market.env 的 TM_IMAGE 使用同一个发布版本（宿主标签不带 v，例如 0.17.2）。
ENGINE_IMAGE=ghcr.io/yx-token/sub2api:0.17.2

POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=

# 首次启动创建的管理员。与 market.env 的 BOOTSTRAP_ADMIN_EMAIL / BOOTSTRAP_ADMIN_PASSWORD 保持一致，
# token-market 的 /admin 用同一账号换发宿主会话，免二次登录。
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 与 market.env 的 MARKET_DB_PASSWORD 相同：宿主的闲猫运营接口直连市场库
MARKET_DB_PASSWORD=

# token-market 只读访问宿主库的账号 tm_readonly 的密码（首次部署时创建，见 README）
READONLY_PASSWORD=

# 宿主进程内经 enginehost 构建市场应用（relay 路由：inspection/checks、org/*、ledger 等）。
# 以下值必须与 market.env 完全一致，否则 relay 路由返回 503 "market ledger unavailable"
SUB2API_ADMIN_API_KEY=
CRYPTO_ACTIVE_KEY_ID=k1
CRYPTO_KEYS=
CRYPTO_HASH_PEPPER=
# 市场自己的 JWT 密钥（market.env 的 JWT_SECRET），不要与上面宿主的 JWT_SECRET 混用
MARKET_JWT_SECRET=

# SUB2API_PUBLIC_PORT=8081
