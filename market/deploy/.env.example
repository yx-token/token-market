# 复制为 .env 后填写。镜像版本由发布流水线写入建议值。
TM_IMAGE=ghcr.io/yx-token/token-market:latest

MARKET_DB_PASSWORD=change-me
CRYPTO_ACTIVE_KEY_ID=k1
CRYPTO_KEYS=k1:base64-32-byte-key
CRYPTO_HASH_PEPPER=change-me-pepper
JWT_SECRET=change-me-jwt-secret-at-least-32-chars

# 网关 / 管理 API（同机可指向 backend 服务）
SUB2API_BASE_URL=http://engine:8080
SUB2API_GATEWAY_URL=
SUB2API_ADMIN_API_KEY=
SUB2API_REPLICA_DSN=

EDGE_PUBLIC_URL=https://api.example.com
TRUSTED_PROXIES=

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
