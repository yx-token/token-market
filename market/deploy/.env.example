# 复制为 .env（单机部署为 market.env，权限 600）后填写。所有密钥都用随机值：openssl rand -base64 32
# 镜像固定到某个发布版本（Release 附件中的示例已写入当次版本）；单机部署与宿主 ENGINE_IMAGE 使用同一版本。
TM_IMAGE=ghcr.io/yx-token/token-market:latest

# 管理后台「系统更新」读取的仓库；公开仓库无需令牌。
UPDATE_REPOSITORY=yx-token/token-market
UPDATE_GITHUB_TOKEN=

MARKET_DB_PASSWORD=change-me

# 字段加密密钥环（"id:base64" 逗号分隔，轮换时追加新密钥并切换 CRYPTO_ACTIVE_KEY_ID）与盲索引密钥（一经使用不能更换）
CRYPTO_ACTIVE_KEY_ID=k1
CRYPTO_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
CRYPTO_HASH_PEPPER=REPLACE_WITH_RANDOM_STRING
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_BYTES_RANDOM

# 闲猫宿主（sub2api）。单机部署经共享网络访问 http://sub2api:8080。
# Admin API Key 在宿主后台确认《部署与运营合规承诺》后生成；只读库账号只需 SELECT 权限。
SUB2API_BASE_URL=http://sub2api:8080
SUB2API_GATEWAY_URL=
SUB2API_ADMIN_API_KEY=
SUB2API_REPLICA_DSN=postgres://tm_readonly:password@sub2api-postgres:5432/sub2api?sslmode=disable

# 首次启动时创建的管理员。/admin 用当前管理员邮箱和这个密码登录宿主（免二次登录），
# 因此须与宿主的 ADMIN_EMAIL / ADMIN_PASSWORD 一致，且部署后不要删除。
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# 买家调用模型的公网地址（指向 edge），在买家控制台展示
EDGE_PUBLIC_URL=https://api.example.com
# 前置负载均衡 / 反向代理的地址（IP 或 CIDR，逗号分隔）；只有来自它们的请求才采信 X-Forwarded-For
TRUSTED_PROXIES=

API_PORT=8080
EDGE_PORT=8090
