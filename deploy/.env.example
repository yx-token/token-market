# 复制为 deploy/.env 后填写。所有密钥都要用随机值，生成方式：openssl rand -base64 32

MARKET_DB_PASSWORD=change-me

# sub2api（内网地址）。管理员需先在 sub2api 后台完成《部署与运营合规承诺》确认，并生成 Admin API Key；
# sub2api 需要关闭登录验证码；只读库账号只需 SELECT 权限。
SUB2API_BASE_URL=http://sub2api:8080
SUB2API_GATEWAY_URL=
SUB2API_ADMIN_API_KEY=
SUB2API_REPLICA_DSN=postgres://readonly:password@sub2api-postgres:5432/sub2api?sslmode=disable

# 字段加密密钥环（"id:base64" 逗号分隔，轮换时追加新密钥并切换 CRYPTO_ACTIVE_KEY_ID）与盲索引密钥（一经使用不能更换）
CRYPTO_ACTIVE_KEY_ID=k1
CRYPTO_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
CRYPTO_HASH_PEPPER=REPLACE_WITH_RANDOM_STRING
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_BYTES_RANDOM

# 首次启动时创建的管理员（之后可以删除）
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# 买家调用模型的公网地址（指向 edge），在买家控制台展示
EDGE_PUBLIC_URL=https://api.example.com
# 前置负载均衡 / 反向代理的地址（IP 或 CIDR，逗号分隔）；只有来自它们的请求才采信 X-Forwarded-For
TRUSTED_PROXIES=

# 支付：market-api 的公网地址（支付宝 / 微信支付的异步通知要能访问到 <地址>/api/payments/{alipay|wechat}/notify）。
# 密钥文件放到 deploy/secrets/ 目录，这里填写容器内路径 /app/secrets/<文件名>。不填 APP_ID / MCH_ID 表示不启用该渠道。
PAYMENT_PUBLIC_URL=https://market.example.com
# 支付宝：签约电脑网站支付与当面付。公钥模式填 ALIPAY_PUBLIC_KEY_FILE；证书模式改填三个证书文件
ALIPAY_APP_ID=
ALIPAY_GATEWAY=
ALIPAY_PRIVATE_KEY_FILE=/app/secrets/alipay_app_private.pem
ALIPAY_PUBLIC_KEY_FILE=/app/secrets/alipay_public.pem
ALIPAY_APP_CERT_FILE=
ALIPAY_CERT_FILE=
ALIPAY_ROOT_CERT_FILE=
# 微信支付 APIv3（Native 扫码）。配置微信支付公钥时填 PUBLIC_KEY_ID / PUBLIC_KEY_FILE，否则自动下载平台证书
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_MCH_SERIAL_NO=
WECHAT_PRIVATE_KEY_FILE=/app/secrets/wechat_apiclient_key.pem
WECHAT_API_V3_KEY=
WECHAT_PUBLIC_KEY_ID=
WECHAT_PUBLIC_KEY_FILE=

API_PORT=8080
EDGE_PORT=8090
