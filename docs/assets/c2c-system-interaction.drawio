                </mxCell>
                <mxCell id="de5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="p4" source="dLoop" target="dOk">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="who" value="争议款托管不解冻。有质检报告时质量纠纷更好裁。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="p4">
                    <mxGeometry x="20" y="292" width="960" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="平台介入仅当买家主动申请，不是卖家一拒绝就自动进。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;" parent="p4" vertex="1">
                    <mxGeometry x="20" y="348" width="960" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="n4c" value="回收退出：卖家关处置即停新流量；已用量照结。平台可因降智/超预算停收。退出后才能再挂 A/B。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="p4">
                    <mxGeometry x="20" y="396" width="960" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="p5" value="⑤ 结算：只结无争议的已用量（商品与回收同一套托管→解冻→提现）" style="swimlane;fontStyle=1;horizontal=1;startSize=36;fillColor=#A5D6A7;strokeColor=#1B5E20;fontColor=#000000;fontSize=15;rounded=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="2408" width="1000" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="w1" value="按成功用量入账&#10;A/B用m_s · 回收用m_b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#1B5E20;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingTop=4;verticalAlign=top;" parent="p5" vertex="1">
                    <mxGeometry x="20" y="52" width="240" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="w2" value="冻结观察期&#10;争议款不解冻" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#1B5E20;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingTop=4;verticalAlign=top;" vertex="1" parent="p5">
                    <mxGeometry x="270" y="52" width="180" height="64" as="geometry"/>
