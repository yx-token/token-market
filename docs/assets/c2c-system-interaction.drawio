                <mxCell id="w3" value="卖家申请提现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingTop=4;verticalAlign=top;" vertex="1" parent="p5">
                    <mxGeometry x="480" y="52" width="160" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="w4" value="平台审核打款" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingTop=4;verticalAlign=top;" vertex="1" parent="p5">
                    <mxGeometry x="670" y="52" width="280" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="we1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="p5" source="w1" target="w2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="we2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="p5" source="w2" target="w3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="we3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="p5" source="w3" target="w4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sum" value="总览：商品只有 A/B。上架后要么挂 A/B 进市场，要么走平台回收进保障池（互斥，发不成 A/B）。&#10;买家下单只对 A/B/保障池 → 使用扣费（池子优先吃回收产能）→ A/B 协商退货 → 结算。&#10;回收：非商品·按量包销·控本封顶·优先吃量换确定性。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#37474F;fontColor=#000000;fontSize=13;align=left;spacingLeft=12;spacingTop=8;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="40" y="2568" width="1000" height="100" as="geometry"/>
                </mxCell>
            </root>
