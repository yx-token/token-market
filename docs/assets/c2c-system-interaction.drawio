                <mxCell id="tags" value="服务标签（卖家勾选即承诺）：七天无理由全退 · 用完才退 · 仅质量问题可退 · ……；「平台质检」只能平台打，不可自贴" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#856404;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="p1">
                    <mxGeometry x="40" y="164" width="960" height="36" as="geometry"/>
