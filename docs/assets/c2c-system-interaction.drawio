                    <mxGeometry x="20" y="144" width="120" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="d2" value="卖家&#10;同意/还价/拒绝" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontColor=#000000;fontSize=12;align=center;" vertex="1" parent="p4">
                    <mxGeometry x="170" y="144" width="140" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="d3" value="买家回应" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#0D47A1;fontColor=#000000;fontSize=12;align=center;" vertex="1" parent="p4">
                    <mxGeometry x="340" y="144" width="120" height="56" as="geometry"/>
