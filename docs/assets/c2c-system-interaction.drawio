                <mxCell id="dLoop" value="协商环&#10;可多次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#856404;fontColor=#000000;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="p4">
                    <mxGeometry x="490" y="144" width="120" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="dOk" value="谈拢→打款" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#1B5E20;fontColor=#000000;fontSize=12;align=center;" vertex="1" parent="p4">
                    <mxGeometry x="640" y="144" width="120" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="e1" value="买家申请介入→平台按标签+证据裁定→执行退款" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="p4">
                    <mxGeometry x="20" y="228" width="960" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="de1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="p4" source="d1" target="d2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="de2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="p4" source="d2" target="d3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="de3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#856404;strokeWidth=2;endArrow=block;endFill=1;dashed=1;" edge="1" parent="p4" source="d3" target="dLoop">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="de4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#856404;strokeWidth=2;endArrow=block;endFill=1;dashed=1;" edge="1" parent="p4" source="dLoop" target="d1">
                    <mxGeometry relative="1" as="geometry">
